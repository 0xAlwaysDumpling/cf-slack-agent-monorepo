# ============================================================================
# CF Agent Monorepo -- Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then run:
#   pnpm run setup
#
# This file is NEVER committed. The setup script reads it to:
#   1. Push secrets to Cloudflare via `wrangler secret bulk`
#   2. Generate per-agent .dev.vars files for local development
# ============================================================================

# -- Cloudflare Account ------------------------------------------------------
# Find these at https://dash.cloudflare.com
# CF_SUBDOMAIN is the subdomain part of your workers.dev URL,
# e.g. if your workers are at *.my-account.workers.dev, put "my-account"
CF_ACCOUNT_ID=
CF_SUBDOMAIN=

# -- Cloudflare AI Gateway ---------------------------------------------------
# All LLM calls go through AI Gateway for logging, caching, and cost tracking.
#
# Setup:
#   1. Go to https://dash.cloudflare.com > AI > AI Gateway
#   2. Create a gateway (the name you choose = CF_GATEWAY)
#   3. In gateway Settings > API Key, create one (= CF_AIG_TOKEN)
#   4. In gateway Settings > Providers, add "Anthropic" and paste your
#      ANTHROPIC_API_KEY (below). Add OpenAI/Google if you want multi-model.
CF_AIG_TOKEN=
CF_GATEWAY=

# -- Anthropic ----------------------------------------------------------------
# Get yours at https://console.anthropic.com/settings/keys
# This key is used in TWO places:
#   1. Added as a provider in AI Gateway (so slack-agent can call Claude)
#   2. Passed directly to dev-agent (for Claude Code in the sandbox)
ANTHROPIC_API_KEY=

# -- Slack App ---------------------------------------------------------------
# Leave these empty on first run. The setup script will guide you through
# creating a Slack app and prompt you to paste these values.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# -- GitHub -------------------------------------------------------------------
# Create a PAT at https://github.com/settings/tokens
#
# Fine-grained PAT (recommended):
#   - Repository access: select repos the agent should work on
#   - Permissions: Contents (read/write), Pull requests (read/write),
#     Issues (read/write), Metadata (read)
#
# Classic PAT: needs scopes: repo, read:org
GITHUB_TOKEN=

# -- Proxy JWT Secret ---------------------------------------------------------
# Used to sign JWTs between the dev-agent and its sandbox.
# Leave empty to auto-generate during setup, or set your own:
#   openssl rand -hex 32
PROXY_JWT_SECRET=

# -- Agent View UI ------------------------------------------------------------
# Simple password to protect the web dashboard
AUTH_PASSWORD=

# -- Optional -----------------------------------------------------------------
# Railway integration (https://railway.com/account/tokens)
# Needs access to your project. Used for: listing services/deployments,
# reading logs, redeploying, reading env vars, running read-only SQL.
RAILWAY_API_TOKEN=
